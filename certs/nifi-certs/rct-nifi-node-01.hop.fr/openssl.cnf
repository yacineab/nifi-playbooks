[ req ]
default_bits       = 2048
prompt             = no
default_md         = sha256
req_extensions     = req_ext
distinguished_name = dn

[ dn ]
C=FR
ST=YourState
L=YourCity
O=YourOrganization
OU=YourUnit
CN=rct-nifi-node-01.hop.fr

[ req_ext ]
subjectAltName = @alt_names

[ alt_names ]
DNS.1 = rct-nifi-node-01.hop.fr
